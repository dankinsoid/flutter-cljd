  (let [f (await (run-seed! tester 256
                            [[:remove 222]
                             [:drag 1211.795711517334]
                             [:layout :list]]))]
    (is (nil? f) (str "NEW-9 the capture pass produced a rebase the segment has "
                      "nowhere to absorb (segAnchor nil):" (fail-str f)))))

