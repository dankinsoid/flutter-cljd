(ns flutter-cljd.core
  (:require
   ["dart:core" :as dc]
   ["dart:ui" :as ui]
   ["package:flutter/foundation.dart" :as fd]
   ["package:flutter/rendering.dart" :as r]
   ["package:flutter/widgets.dart" :as w]
   [cljd.flutter :as f :refer [widget]]
   [flutter-cljd.types :as t]
   [flutter-cljd.inherited-keys :as inh]
   [flutter-cljd.utils :as ut :refer [??]]))

;; -------------------------
;; MARK: Macros
;; -------------------------

(defmacro widget->>
  "Like `widget`, but threads the forms in the body using `->>`.
   While `widget` can thread forms with `.child`, `widget->>` threads pure clojure functions with last form as the child.
   If you don't need any `widget`'s directives, you can use native `->>` instead of `widget->>`, because most IDEs will recognize the `->>` macro.
   And if you don't need any threading, you can use `widget` instead of `widget->>`.
   The macro extracts the keyword-based directives (e.g., :let, :padding) and
   applies `->>` threading to the remaining forms.

   Example:
   ```clojure
   (f/widget->>
    :let [title \"Let's get coding!\"]
    (f/text title)
    (f/with-text-style {:color :red :font-size 32.0})
    (f/padding 8)
    (f/container {:h 40 :alignment :top}))
   ```
    The above code is equivalent to:
   ```clojure
   (widget
     :let [title \"Let's get coding!\"]
     (->>
      (f/text title)
      (f/with-text-style {:color :red :font-size 32.0})
      (f/padding 8)
      (f/container {:h 40 :alignment :top})))
   ```
   That is equivalent to:
   ```clojure
   (widget
      :let [title \"Let's get coding!\"]
      (f/container
        {:h 40 :alignment :top}
        (f/padding 8
        (f/with-text-style {:color :red :font-size 32.0}
          (f/text title)))))
   ```
   "
  [& body]
  (let [directives (take-while #(keyword? (first %)) (partition 2 body))
        body-forms (drop (* 2 (count directives)) body)]
    `(widget ~@(apply concat directives) (->> ~@body-forms))))

;; -------------------------
;; MARK: Helpers
;; -------------------------

(defn get-inherited
  "Retrieves an inherited value from `context` based on the specified `key`.
   Searches for an inherited widget of type `InheritedBindings` in the `context`.
   If found, extracts the `bindings` map from the widget and returns the value 
   associated with `key`. If `key` is not found, returns `default-value?` if provided, or `nil` by default.

     Parameters:
     - `context`: The context to search within.
     - `key`: The key to look up in the bindings. Key can also be a map with the following keys:
       - `:key`: The key to look up in the bindings.
       - `:default-value`: The value to return if `key` is not found. Defaults to `nil`.
     - `default-value`: The value to return if `key` is not found. Defaults to `nil`.
   
   Some default keys are defined in `flutter-cljd.inherited-keys` namespace"
  ([context key] (get-inherited context key nil))
  ([context key default-value]
   (let [[k dflt] (if (and (map? key) (contains? key :key))
                    [(:key key) (?? default-value (:default-value key))]
                    [key default-value])]
     ;; A nil context carries no inherited bindings — return the default rather
     ;; than dispatching `get-of` on nil (which NPEs). Lets builder-wrapped
     ;; widgets be exercised without a live element tree.
     (if (nil? context) dflt (f/get-of context k dflt)))))

(defn ^bool resolve-enabled
  "Effective `enabled` state for a widget: the logical AND of its local value and
   the inherited `flutter-cljd.inherited-keys/enabled` (default true). An unset
   (`nil`) local counts as enabled, so the widget follows the surrounding
   `(enabled ...)`/`(disabled ...)` region; a `false` from either side disables
   it, and a disabled region can't be re-enabled from within."
  [context local]
  (and (get-inherited context inh/enabled)
       (not (false? local))))

;; -------------------------
;; MARK: Environment
;; -------------------------

;; @ai-generated(solo)
(defn ^w/MediaQueryData media-query
  "The nearest `MediaQueryData`. Rebuilds the caller on ANY media change (size,
   insets, text scale, brightness, …) — prefer the granular getters below
   (`screen-size`, `safe-insets`, `view-insets`), which subscribe to one aspect.

   [Flutter docs](https://api.flutter.dev/flutter/widgets/MediaQuery/of.html)"
  [^w/BuildContext context]
  (w/MediaQuery.of context))

(defn ^ui/Size screen-size
  "The size of the media (the window, in logical pixels). Subscribes the caller
   to size changes only (`MediaQuery.sizeOf`)."
  [^w/BuildContext context]
  (w/MediaQuery.sizeOf context))

(defn ^w/EdgeInsets safe-insets
  "The parts of the display obscured by system UI (notch, status and navigation
   bars) — `MediaQuery.paddingOf`. Already reduced by any ancestor `safe-area`
   that consumed them."
  [^w/BuildContext context]
  (w/MediaQuery.paddingOf context))

(defn ^w/EdgeInsets view-insets
  "The parts of the display fully obscured by system UI, typically the on-screen
   keyboard (`.bottom`) — `MediaQuery.viewInsetsOf`."
  [^w/BuildContext context]
  (w/MediaQuery.viewInsetsOf context))

(defn text-direction
  "The ambient text direction as `:ltr`/`:rtl`, or `nil` without a
   `Directionality` ancestor. `flutter-cljd.types/text-direction` converts it
   back to a `TextDirection`."
  [^w/BuildContext context]
  (let [d (w/Directionality.maybeOf context)]
    (cond
      (nil? d) nil
      (= d ui/TextDirection.rtl) :rtl
      :else :ltr)))

(defn ^ui/Rect? global-rect
  "The global (screen) rect of `context`'s render box, or `nil` before layout,
   after unmount, or when the render object isn't a box — e.g. a popover anchor
   for a share sheet. Read it in callbacks, not during build: a build sees the
   previous frame's layout."
  [^w/BuildContext context]
  ;; untyped: findRenderObject is null before layout and a hint casts first
  (let [ro (.findRenderObject context)]
    (when (and (instance? r/RenderBox ro) (.-attached ^r/RenderBox ro) (.-hasSize ^r/RenderBox ro))
      (let [^r/RenderBox box ro]
        (let [tl (.localToGlobal box w/Offset.zero)
              size (.-size box)]
          (ui/Rect.fromLTWH (.-dx tl) (.-dy tl) (.-width size) (.-height size)))))))

(defn cupertino?
  "True on iOS and macOS — where Flutter's own `.adaptive` constructors render
   Cupertino widgets. Reads
   `defaultTargetPlatform`, so `debugDefaultTargetPlatformOverride` applies in
   tests and previews. Adaptive widgets (`switch`, `activity-indicator`,
   `adaptive-scaffold`) switch on this."
  []
  (let [p fd/defaultTargetPlatform]
    (or (= p fd/TargetPlatform.iOS) (= p fd/TargetPlatform.macOS))))

(defn app-lifecycle-state
  "The app's current lifecycle state as a keyword — `:resumed`, `:inactive`,
   `:hidden`, `:paused`, `:detached` — or `nil` before the platform reported one
   (cold start). See `flutter-cljd.types/app-lifecycle-state` for their meaning
   and `life-cycle-observer` to react to changes."
  []
  (let [s (.-lifecycleState w/WidgetsBinding.instance)]
    (cond
      (nil? s) nil
      (= s ui/AppLifecycleState.resumed) :resumed
      (= s ui/AppLifecycleState.inactive) :inactive
      (= s ui/AppLifecycleState.hidden) :hidden
      (= s ui/AppLifecycleState.paused) :paused
      :else :detached)))

(defn post-frame!
  "Runs `f` (no args) once, right after the current frame is laid out and
   painted — the place to read geometry (`global-rect`) or start work that must
   not run during build. Schedules a frame if none is pending."
  [f]
  (.addPostFrameCallback w/WidgetsBinding.instance (fn [_] (f) nil))
  (.ensureVisualUpdate w/WidgetsBinding.instance)
  nil)

;; @ai-generated(solo)
(defn ^ui/Size measure-text
  "Lays out `text` (a string or an `InlineSpan`) and returns its `Size` — e.g.
   to size a cell ahead of building it.

   `style` is anything `flutter-cljd.types/text-style` accepts (a map or a
   `TextStyle`); it is not merged with any `DefaultTextStyle`, so pass the full
   style the widget will render with. Options:
   - `:max-width` — wrap width (default unbounded, one line per paragraph)
   - `:max-lines` — line cap; overflow is cut, not ellipsized
   - `:text-direction` — `:ltr` (default) / `:rtl` / `TextDirection`
   - `:text-scaler` — a `TextScaler` (default none; pass
     `(MediaQuery.textScalerOf ctx)` to match rendered text)

   ```clojure
   (.-height (measure-text title {:size 12 :height 1.33} {:max-width 120 :max-lines 2}))
   ```"
  ([text style] (measure-text text style {}))
  ([text style {:keys [max-width max-lines text-direction text-scaler]}]
   (let [span (if (instance? w/InlineSpan text)
                text
                (w/TextSpan .text (str text) .style (t/text-style style)))
         ;; a span's own style wins over `style`, which becomes its default
         span (if (instance? w/InlineSpan text)
                (w/TextSpan .style (t/text-style style) .children [span])
                span)
         tp (w/TextPainter
             .text span
             .textDirection (t/text-direction (or text-direction :ltr))
             .maxLines (some-> max-lines int)
             .textScaler (or text-scaler w/TextScaler.noScaling))]
     (.layout tp .maxWidth (if max-width (double max-width) dc/double.infinity))
     (let [size (.-size tp)]
       (.dispose tp)
       size))))
