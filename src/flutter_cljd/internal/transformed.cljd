(ns flutter-cljd.internal.transformed
  (:require
   ["package:flutter/material.dart" :as m]
   [flutter-cljd.utils :as ut :refer [??]]
   [flutter-cljd.types :as t]))

(defn ^m/Widget transform* [transform {:keys [key origin alignment transform-hit-tests filter-quality]} child]
  (m/Transform
    .key (t/widget-key key)
    .transform (t/mat4 transform)
    .origin (some-> origin t/offset)
    .alignment (or (some-> alignment t/alignment-geometry) m/Alignment.center)
    .transformHitTests (?? (some-> transform-hit-tests boolean) true)
    .filterQuality filter-quality
    .child child))

(defn ^m/Widget flip* [axis args child]
  (let [axis (if (coll? axis) (map t/axis axis) [(t/axis axis)])
        axis (set (map #(if (= % m/Axis.vertical) :v :h) axis))]
       (transform* (t/mat4-diagonal3 
                    (if (axis :h) -1 1)
                    (if (axis :v) -1 1)
                    1) 
                   args 
                   child)))

(defn ^m/Widget rotate* [angle {:keys [key origin alignment transform-hit-tests filter-quality]} child]
  (m/Transform.rotate
   .key (t/widget-key key)
   .angle (double angle)
   .origin (some-> origin t/offset)
   .alignment (or (some-> alignment t/alignment-geometry) m/Alignment.center)
   .transformHitTests (?? (some-> transform-hit-tests boolean) true)
   .filterQuality filter-quality
   .child child))

(defn ^m/Widget rotate-layout* [quarter-turns child]
  (m/RotatedBox
   .quarterTurns (int quarter-turns)
   .child child))

(defn- ^m/Widget scale-static* [scale args child]
  (let [scale-x (cond (map? scale) (:x scale 1)
                      (coll? scale) (or (first scale) 1)
                      :else scale)
        scale-y (cond (map? scale) (:y scale 1)
                      (coll? scale) (or (last scale) 1)
                      :else scale)]
    (transform* (t/mat4-diagonal3
                 (double scale-x)
                 (double scale-y)
                 1)
                args
                child)))

(defn ^m/Widget scale* [scale args child]
  (if (instance? m/Animation scale)
    (m/ScaleTransition
     .key (t/widget-key (:key args))
     .scale scale
     .alignment (or (some-> (:alignment args) t/alignment) m/Alignment.center)
     .filterQuality (some-> (:filter-quality args) t/filter-quality)
     .child child)
    (scale-static* scale args child)))

(defn ^m/Widget translate* [offset args child]
  (if (instance? m/Animation offset)
    (let [^m/Animation animation offset
          {:keys [key transform-hit-tests filter-quality]} args]
      (m/AnimatedBuilder
       .key (t/widget-key key)
       .animation animation
       .builder (fn [_ ^m/Widget? c]
                  (m/Transform.translate
                   .offset (t/offset (.-value animation))
                   .transformHitTests (?? (some-> transform-hit-tests boolean) true)
                   .filterQuality (some-> filter-quality t/filter-quality)
                   .child c))
       .child child))
    (let [offset (t/offset offset)]
      (transform* (t/mat4-translation (.-dx offset) (.-dy offset)) args child))))

(defn ^m/Widget fractional-translation* [offset {:keys [key transform-hit-tests]} child]
  (if (instance? m/Animation offset)
    (m/SlideTransition
     .key (t/widget-key key)
     .position offset
     .transformHitTests (?? (some-> transform-hit-tests boolean) true)
     .child child)
    (m/FractionalTranslation
   .key (t/widget-key key)
   .translation (t/offset offset)
   .transformHitTests (?? (some-> transform-hit-tests boolean) true)
   .child child)))

(defn ^m/Widget transform-macro [value fun args]
  (if (keyword? value)
    (let [[args children] (ut/key-values-args-and-children (cons value args))]
      (fun args args (last children)))
    (let [values (take-while number? args)
          value (if (empty? values) value (vec (cons value values)))
          [args children] (ut/key-values-args-and-children (drop (count values) args))]
      (fun value args (last children)))))
